    },

    // ───────────────────────── Windows Update ─────────────────────────
    {
      "id": "wu.noP2PUpload", "category": "Windows Update", "name": "Don't upload updates to other PCs on the internet",
      "description": "Delivery Optimization will only download from Microsoft, never upload your bandwidth to strangers.",
      "risk": "Safe", "restart": "None", "recommended": true,
      "registry": [ { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DeliveryOptimization", "name": "DODownloadMode", "kind": "DWord", "on": 0, "off": null } ]
    },
    {
      "id": "wu.noDrivers", "category": "Windows Update", "name": "Don't get drivers from Windows Update",
      "description": "Stops Windows Update replacing drivers you installed from NVIDIA/AMD/your PC maker. Only enable this if you manage drivers yourself.",
      "risk": "Advanced", "restart": "None",
      "registry": [ { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate", "name": "ExcludeWUDriversInQualityUpdate", "kind": "DWord", "on": 1, "off": null } ]
    },
    {
      "id": "wu.noAutoRestart", "category": "Windows Update", "name": "No automatic restart while you're signed in",
      "description": "Windows Update waits for you to restart instead of rebooting on its own while you're signed in.",
      "risk": "Safe", "restart": "None",
      "registry": [ { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU", "name": "NoAutoRebootWithLoggedOnUsers", "kind": "DWord", "on": 1, "off": null } ]
    },

    // ───────────────────────── Services ─────────────────────────
    {
