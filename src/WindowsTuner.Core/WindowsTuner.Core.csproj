<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Plain net10.0 so the pure logic (parsers, tweak engine, recommendations) can be unit-tested on any OS.
         Everything that touches Windows APIs is guarded by SupportedOSPlatform("windows"). -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WindowsTuner.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Tweaks\tweaks.json" LogicalName="WindowsTuner.Core.tweaks.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WindowsTuner.Tests" />
  </ItemGroup>
</Project>
