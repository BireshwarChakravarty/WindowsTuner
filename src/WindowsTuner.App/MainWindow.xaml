<Window x:Class="WindowsTuner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowsTuner" Height="820" Width="1280" MinHeight="600" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/WindowsTuner.ico"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,20,0,22">
                    <Image Source="Assets/WindowsTuner.ico" Width="30" Height="30"/>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="WindowsTuner" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="Update · Speed up · Customize" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="18,8,18,14">
                    <Border x:Name="AdminBadge" CornerRadius="6" Padding="8,5" Background="{DynamicResource CardBrush}">
                        <TextBlock x:Name="AdminText" FontSize="11" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock x:Name="VersionText" FontSize="11" Margin="0,8,0,0" Foreground="{DynamicResource SubTextBrush}"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Nav">
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Dashboard" x:Name="NavDashboard" Click="Nav_Click"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE945;" Content="One-click Tune-up" x:Name="NavTuneUp" Click="Nav_Click"/>
                        <TextBlock Text="KEEP UP TO DATE" FontSize="11" Margin="22,14,0,4" Foreground="{DynamicResource SubTextBrush}"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE895;" Content="Updates" x:Name="NavUpdates" Click="Nav_Click"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE772;" Content="Drivers" x:Name="NavDrivers" Click="Nav_Click"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE72E;" Content="Security" x:Name="NavSecurity" Click="Nav_Click"/>
                        <TextBlock Text="SPEED UP" FontSize="11" Margin="22,14,0,4" Foreground="{DynamicResource SubTextBrush}"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE74D;" Content="Clean up" x:Name="NavCleanup" Click="Nav_Click"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE768;" Content="Startup apps" x:Name="NavStartup" Click="Nav_Click"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE9F5;" Content="Background tasks" x:Name="NavBackground" Click="Nav_Click"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE71D;" Content="Remove bloat" x:Name="NavApps" Click="Nav_Click"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE8B7;" Content="Programs &amp; files" x:Name="NavPrograms" Click="Nav_Click"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xEC4A;" Content="Performance" x:Name="NavPerformance" Click="Nav_Click"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE968;" Content="Network" x:Name="NavNetwork" Click="Nav_Click"/>
                        <TextBlock Text="MAKE IT YOURS" FontSize="11" Margin="22,14,0,4" Foreground="{DynamicResource SubTextBrush}"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE771;" Content="Tweaks" x:Name="NavTweaks" Click="Nav_Click"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE9D9;" Content="Health &amp; repair" x:Name="NavHealth" Click="Nav_Click"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings" x:Name="NavSettings" Click="Nav_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Content + log -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl x:Name="PageHost" Margin="28,22,16,8" Focusable="False"/>

            <Border Grid.Row="1" x:Name="LogPanel" Height="170" Margin="16,0,16,8" Style="{StaticResource Card}" Padding="8" Visibility="Collapsed">
                <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" FontFamily="Cascadia Mono, Consolas"
                         FontSize="12" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="2,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="T" Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="Success">
                                    <Setter TargetName="T" Property="Foreground" Value="{DynamicResource GoodBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                    <Setter TargetName="T" Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                    <Setter TargetName="T" Property="Foreground" Value="{DynamicResource BadBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Info">
                                    <Setter TargetName="T" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed" Padding="10,3" Margin="0,0,8,0"/>
                        <Button x:Name="LogToggle" Content="Show activity log" Click="LogToggle_Click" Padding="10,3" Margin="0,0,8,0"/>
                        <Button Content="Open log file" Click="OpenLog_Click" Padding="10,3" Margin="0"/>
                    </StackPanel>
                    <ProgressBar x:Name="BusyBar" DockPanel.Dock="Left" Width="120" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
