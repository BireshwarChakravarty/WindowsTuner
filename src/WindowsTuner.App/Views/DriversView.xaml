<UserControl x:Class="WindowsTuner.App.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource H1}" Text="Drivers"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Driver updates install from Windows Update (Updates page → Windows &amp; drivers). For the newest graphics and chipset drivers use the official tools below. Never use third-party &quot;driver updater&quot; programs — many bundle adware or install wrong drivers."/>
            <WrapPanel>
                <Button x:Name="RefreshButton" Style="{StaticResource PrimaryButton}" Content="Scan drivers" Click="Refresh_Click"/>
                <Button x:Name="BackupButton" Content="Back up all drivers" Click="Backup_Click"
                        ToolTip="Exports every third-party driver so you can restore it if an update misbehaves."/>
                <Button x:Name="WuDriversButton" Content="Get driver updates from Windows Update" Click="WuDrivers_Click"/>
                <Button x:Name="ScanHwButton" Content="Scan for hardware changes" Click="ScanHw_Click"/>
                <Button Content="Device Manager" Click="DevMgr_Click"/>
            </WrapPanel>
            <TextBlock x:Name="HardwareText" Style="{StaticResource Sub}" Margin="0,0,0,8"/>

            <TextBlock Style="{StaticResource H2}" Text="Official update tools for your hardware"/>
            <ItemsControl x:Name="VendorTools">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="290" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Reason}" Style="{StaticResource Sub}" Margin="0,3,0,8" Height="34"/>
                                <Button Style="{StaticResource LinkButton}" Content="Open download page →" Tag="{Binding Url}" Click="OpenUrl_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="ProblemHeader" Style="{StaticResource H2}" Text="Devices with problems"/>
            <DataGrid x:Name="ProblemGrid" MaxHeight="160" Margin="0,0,0,8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Device" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding DeviceClass}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Problem" Binding="{Binding Problem}" Width="3*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Margin="0,8,0,8">
                <CheckBox x:Name="ShowMicrosoft" DockPanel.Dock="Right" Content="Show Windows' built-in drivers" Click="Filter_Click" Margin="0"/>
                <TextBlock x:Name="DriverSummary" Style="{StaticResource H2}" Margin="0" Text="Installed drivers"/>
            </DockPanel>
        </StackPanel>
        <DataGrid x:Name="DriverGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="2.5*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Type" Binding="{Binding DeviceClass}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Age (yrs)" Binding="{Binding AgeYears}" Width="70" IsReadOnly="True"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Outdated}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </DockPanel>
</UserControl>
