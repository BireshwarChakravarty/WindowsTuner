<UserControl x:Class="WindowsTuner.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource H1}" Text="Performance"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="See what's using your PC right now, pick a power plan and optimize your drives. For visual effects, animations and background services see Tweaks → Performance."/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <DockPanel Margin="0,0,12,0">
                <WrapPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource H2}" Text="What's using your PC" Margin="0,4,16,8"/>
                    <Button x:Name="RefreshProcButton" Content="Refresh" Click="RefreshProc_Click"/>
                    <Button x:Name="EndButton" Content="End selected app" Click="End_Click" Style="{StaticResource DangerButton}"/>
                </WrapPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Sub}" Margin="0,8,0,0"
                           Text="Right after a long break, expect MsMpEng (Defender scan), TiWorker / TrustedInstaller (installing updates), SearchIndexer and OneDrive near the top. Let them finish — ending them only delays the work."/>
                <DataGrid x:Name="ProcGrid" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="1.6*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="70" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Memory" Binding="{Binding Memory}" Width="90" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Power plan" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,8"
                                       Text="High/Ultimate performance keep the CPU at full speed: snappier on desktops, but worse battery life and more heat on laptops."/>
                            <ItemsControl x:Name="Plans">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="plan" Content="{Binding Name}" IsChecked="{Binding IsActive, Mode=OneWay}"
                                                     Tag="{Binding Guid}" Click="Plan_Click"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Add Ultimate Performance" Click="Ultimate_Click"/>
                                <Button Content="Power Options" Click="PowerOptions_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Optimize drives" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,8"
                                       Text="Runs Windows' own optimizer: TRIM for SSDs (tells the SSD which blocks are free), defragment for hard disks. It never defragments an SSD."/>
                            <WrapPanel>
                                <Button x:Name="OptimizeButton" Style="{StaticResource PrimaryButton}" Content="Optimize all drives" Click="Optimize_Click"/>
                                <Button Content="Optimize Drives app" Click="OptimizeApp_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="More" FontWeight="SemiBold" FontSize="14"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Visual effects settings" Click="VisualFx_Click"/>
                                <Button Content="Graphics settings" Click="Graphics_Click"/>
                                <Button Content="Task Manager" Click="TaskMgr_Click"/>
                                <Button Content="Resource Monitor" Click="ResMon_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
