<UserControl x:Class="WindowsTuner.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,16" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource H1}" Text="Settings"/>
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Make WindowsTuner itself look and behave the way you like."/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <RadioButton x:Name="ThemeDark" GroupName="theme" Content="Dark" Click="Theme_Click"/>
                        <RadioButton x:Name="ThemeLight" GroupName="theme" Content="Light" Click="Theme_Click"/>
                        <RadioButton x:Name="ThemeSystem" GroupName="theme" Content="Follow Windows" Click="Theme_Click"/>
                    </WrapPanel>
                    <TextBlock Text="Accent colour" Margin="0,8,0,6" Style="{StaticResource Sub}"/>
                    <ItemsControl x:Name="Swatches">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="30" Height="30" Padding="0" Margin="0,0,8,8" Tag="{Binding}" Click="Swatch_Click" Background="{Binding}" BorderBrush="Transparent" ToolTip="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="CustomAccent" Width="110" ToolTip="Any colour as #RRGGBB"/>
                        <Button Content="Use colour" Click="CustomAccent_Click" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Safety" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                    <CheckBox x:Name="RestorePoints" Content="Create a restore point before big changes (updates, app removal, tweak profiles)" Click="Option_Click"/>
                    <CheckBox x:Name="SystemMode" Content="Hyper-admin mode: use the SYSTEM account when administrator rights aren't enough" Click="Option_Click"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="24,0,0,0"
                               Text="Off by default. Used only for fixed, safe operations: cleaning protected Windows temp/report folders, and changing vendor services or scheduled tasks that lock out administrators. Running things as SYSTEM through Task Scheduler is also a trick malware uses, so some antivirus products may warn when this is on. WindowsTuner never runs as TrustedInstaller or switches off Windows' own protections."/>
                    <TextBlock x:Name="PrivilegeText" Margin="0,8,0,0" Style="{StaticResource Sub}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="App updates" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                    <TextBlock Style="{StaticResource Sub}" Text="Apps on your skip list are never updated by WindowsTuner or the weekly tune-up:" Margin="0,0,0,6"/>
                    <ListBox x:Name="Excluded" Height="110" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}"/>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBox x:Name="NewExclusion" Width="260" ToolTip="winget package ID, e.g. Mozilla.Firefox"/>
                        <Button Content="Add" Click="AddExclusion_Click" Margin="8,0,8,8"/>
                        <Button Content="Remove selected" Click="RemoveExclusion_Click"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,6"
                               Text="Optional: the Microsoft.WinGet.Client PowerShell module gives WindowsTuner exact (never truncated) app IDs and versions."/>
                    <Button x:Name="ModuleButton" Content="Install WinGet PowerShell module" Click="Module_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Your data" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                    <TextBlock x:Name="DataPath" Style="{StaticResource Sub}" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button Content="Open data folder" Click="OpenData_Click"/>
                        <Button Content="Open logs" Click="OpenLogs_Click"/>
                        <Button Content="Driver &amp; profile backups" Click="OpenBackups_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="About" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                    <TextBlock Style="{StaticResource Sub}"
                               Text="WindowsTuner only uses Windows' own tools and official sources: winget, the Microsoft Store, Windows Update, DISM, SFC, Defender, Task Scheduler and documented registry settings. It contains no registry cleaner, RAM booster or third-party driver downloader — those don't make PCs faster and often cause harm. Open source under the MIT license."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
