<UserControl x:Class="WindowsTuner.App.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource H1}" Text="Remove bloat"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Preinstalled Store apps you may never use. They take disk space, show up in search and some run in the background. Everything here can be reinstalled from the Microsoft Store. Core parts of Windows are protected and can't be selected."/>
            <WrapPanel>
                <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click"/>
                <Button Content="Select suggested" Click="SelectSuggested_Click"/>
                <Button x:Name="RemoveButton" Style="{StaticResource PrimaryButton}" Content="Remove selected" Click="Remove_Click"/>
                <Button Content="Installed programs (Settings)" Click="Programs_Click"/>
            </WrapPanel>
            <WrapPanel Margin="0,0,0,8">
                <CheckBox x:Name="OnlySuggested" Content="Show only apps rated &quot;Safe to remove&quot; or &quot;Optional&quot;" IsChecked="True" Click="Filter_Click"/>
                <CheckBox x:Name="ForNewUsers" Content="Also remove for new user accounts"/>
            </WrapPanel>
        </StackPanel>
        <DataGrid x:Name="Grid">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="40" Header="">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="App" Binding="{Binding FriendlyName}" Width="1.5*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Rating" Binding="{Binding RatingText}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Package" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="1.5*" IsReadOnly="True"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsProtected}" Value="True">
                            <Setter Property="Opacity" Value="0.5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </DockPanel>
</UserControl>
