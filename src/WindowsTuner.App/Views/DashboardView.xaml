<UserControl x:Class="WindowsTuner.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click"/>
                    <Button x:Name="DeepScanButton" Content="Check updates &amp; drivers" Click="DeepScan_Click"
                            ToolTip="Also asks winget and Windows Update what's out of date (takes a few minutes)."/>
                    <Button Style="{StaticResource PrimaryButton}" Content="⚡ One-click Tune-up" Click="TuneUp_Click"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Your PC at a glance"/>
                    <TextBlock x:Name="Subtitle" Style="{StaticResource PageSubtitle}" Text="Checking your PC…"/>
                </StackPanel>
            </DockPanel>

            <WrapPanel>
                <!-- Score -->
                <Border Style="{StaticResource Card}" Width="210" Height="150">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="ScoreText" Text="—" FontSize="52" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ScoreLabel" Text="Health score" HorizontalAlignment="Center" Style="{StaticResource Sub}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="260" Height="150">
                    <StackPanel>
                        <TextBlock Text="WINDOWS" FontSize="11" Style="{StaticResource Sub}"/>
                        <TextBlock x:Name="OsText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,4"/>
                        <TextBlock x:Name="UptimeText" Style="{StaticResource Sub}"/>
                        <TextBlock x:Name="RebootText" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="260" Height="150">
                    <StackPanel>
                        <TextBlock Text="PROCESSOR" FontSize="11" Style="{StaticResource Sub}"/>
                        <TextBlock x:Name="CpuName" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,8" MaxHeight="40"/>
                        <ProgressBar x:Name="CpuBar" Maximum="100"/>
                        <TextBlock x:Name="CpuText" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="260" Height="150">
                    <StackPanel>
                        <TextBlock Text="MEMORY" FontSize="11" Style="{StaticResource Sub}"/>
                        <TextBlock x:Name="RamText" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,8"/>
                        <ProgressBar x:Name="RamBar" Maximum="100"/>
                        <TextBlock x:Name="RamSub" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="260" Height="150">
                    <StackPanel>
                        <TextBlock x:Name="DiskTitle" Text="SYSTEM DRIVE" FontSize="11" Style="{StaticResource Sub}"/>
                        <TextBlock x:Name="DiskText" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,8"/>
                        <ProgressBar x:Name="DiskBar" Maximum="100"/>
                        <TextBlock x:Name="DiskSub" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="260" Height="150">
                    <StackPanel>
                        <TextBlock Text="AT A GLANCE" FontSize="11" Style="{StaticResource Sub}"/>
                        <TextBlock x:Name="StartupText" Margin="0,8,0,2"/>
                        <TextBlock x:Name="DefenderText" Margin="0,2"/>
                        <TextBlock x:Name="DevicesText" Margin="0,2"/>
                        <TextBlock x:Name="UpdatesText" Margin="0,2" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <TextBlock Style="{StaticResource H2}" Text="What to do next"/>
            <ItemsControl x:Name="Recs">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,12,8">
                            <DockPanel>
                                <TextBlock x:Name="Icon" Text="{Binding Icon}" FontSize="20" Width="36" VerticalAlignment="Top"
                                           Foreground="{DynamicResource InfoBrush}"/>
                                <Button DockPanel.Dock="Right" Content="{Binding FixText}" Tag="{Binding Fix}" Click="Fix_Click" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Fix}" Value="None">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Sub}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource BadBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Good">
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource GoodBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Expander Margin="0,8,12,24" IsExpanded="False">
                <Expander.Header>
                    <TextBlock Text="Why is my PC so slow after being switched off for a long time?" FontWeight="SemiBold" FontSize="14"/>
                </Expander.Header>
                <TextBlock Style="{StaticResource Sub}" Margin="24,8,0,0" LineHeight="20">
                    <Run Text="When a PC wakes up after weeks or months, Windows has a backlog: it downloads and installs every missed update (sometimes several in a row, because some updates are prerequisites for others), Microsoft Defender updates its definitions and runs a full scan, the search indexer re-scans your files, OneDrive re-syncs, and every app's own updater starts at once. That can pin the disk and CPU at 100% for an hour or more — especially on a hard disk."/>
                    <LineBreak/><LineBreak/>
                    <Run Text="What actually helps, in order: 1) plug in, connect to the internet and let Windows Update finish, then RESTART (not shut down); 2) update apps and drivers (Updates page); 3) disable startup apps you don't need; 4) free disk space; 5) remove preinstalled bloat. Registry cleaners and 'RAM boosters' do not help — Microsoft does not support them and they can break things, so WindowsTuner deliberately doesn't include them."/>
                </TextBlock>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
