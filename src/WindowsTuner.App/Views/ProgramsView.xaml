<UserControl x:Class="WindowsTuner.App.Views.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource H1}" Text="Programs &amp; files"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Everything installed on this PC (not just Store apps), and the big or forgotten files filling up your drive."/>
        </StackPanel>
        <TabControl>
            <TabItem Header="Installed programs">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top">
                        <TextBox x:Name="Search" Width="240" Margin="0,0,8,8" TextChanged="Search_TextChanged" ToolTip="Search by name or publisher"/>
                        <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click"/>
                        <Button x:Name="UninstallButton" Style="{StaticResource DangerButton}" Content="Uninstall selected program" Click="Uninstall_Click"/>
                        <Button Content="Open install folder" Click="OpenFolder_Click"/>
                        <ComboBox x:Name="SortBox" Width="170" SelectionChanged="Sort_Changed"/>
                        <TextBlock x:Name="ProgramSummary" VerticalAlignment="Center" Margin="8,0,0,8" Style="{StaticResource Sub}"/>
                    </WrapPanel>
                    <DataGrid x:Name="ProgramGrid" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Program" Binding="{Binding Name}" Width="2.4*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1.4*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Installed" Binding="{Binding Installed}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="For" Binding="{Binding Scope}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.2*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Large &amp; forgotten files">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top">
                        <Button x:Name="ScanFilesButton" Style="{StaticResource PrimaryButton}" Content="Scan my files" Click="ScanFiles_Click"/>
                        <Button x:Name="RecycleButton" Content="Move selected to Recycle Bin" Click="Recycle_Click"/>
                        <Button Content="Show in Explorer" Click="ShowFile_Click"/>
                        <TextBlock x:Name="FileSummary" VerticalAlignment="Center" Margin="8,0,0,8" Style="{StaticResource Sub}"
                                   Text="Looks through your user folders for files over 250 MB and old installers / archives in Downloads. Online-only OneDrive files are skipped. Nothing is deleted without you selecting it, and deleted files go to the Recycle Bin."/>
                    </WrapPanel>
                    <DataGrid x:Name="FileGrid">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="40" Header="">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                            <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Why" Binding="{Binding Reason}" Width="1.2*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="3*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
