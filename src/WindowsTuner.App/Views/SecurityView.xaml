<UserControl x:Class="WindowsTuner.App.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource H1}" Text="Security checkup"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="The settings that matter most for keeping a home PC safe, checked in one go. A PC that has been off for months is most at risk until it's fully updated."/>
            <WrapPanel>
                <Button x:Name="RunButton" Style="{StaticResource PrimaryButton}" Content="Check again" Click="Run_Click"/>
                <Button Content="Windows Security" Click="Security_Click"/>
                <TextBlock x:Name="Summary" VerticalAlignment="Center" Margin="8,0,0,8" FontWeight="SemiBold"/>
            </WrapPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Checks">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,12,8">
                            <DockPanel>
                                <TextBlock x:Name="Icon" Text="{Binding Icon}" FontSize="18" Width="34" Foreground="{DynamicResource GoodBrush}" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="{Binding FixLabel}" Click="Fix_Click" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanFix}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Warning">
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Bad">
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource BadBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Unknown">
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
